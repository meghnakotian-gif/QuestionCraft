# ============================================================
#  .gitignore — Files Git Should Never Track
# ============================================================
#  Add this file to every project.  It stops sensitive data
#  and unnecessary files from being pushed to GitHub.
# ============================================================

# --- Environment / Secrets (MOST IMPORTANT) ---
.env                  # Your real passwords & keys live here

# --- Python Virtual Environment ---
venv/
env/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Python packaging artifacts ---
*.egg-info/
dist/
build/

# --- IDE / Editor folders ---
.vscode/
.idea/
*.suo
*.user

# --- OS-generated files ---
.DS_Store             # macOS
Thumbs.db             # Windows
desktop.ini

# --- Logs ---
*.log
logs/
